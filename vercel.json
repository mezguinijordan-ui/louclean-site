{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "louclean.fr" }
      ],
      "destination": "https://www.louclean.fr/:path*",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/choisir-entreprise-nettoyage-bureaux-paris",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/choisir-entreprise-nettoyage-bureaux-paris",
      "permanent": true
    },
    {
      "source": "/book-online",
      "destination": "/#devis",
      "permanent": true
    },
    {
      "source": "/_api/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
